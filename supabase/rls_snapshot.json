{
  "$schema": "./rls_snapshot.schema.json",
  "description": "Expected end-state of RLS policies, storage bucket visibility, and security triggers after applying every migration in supabase/migrations. Regenerate with `node scripts/check-rls.mjs --update-snapshot` after an intentional, reviewed policy change.",
  "policies": {
    "public.bookmarks": [
      {
        "name": "Users can delete own bookmarks",
        "cmd": "delete",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "auth.uid()=user_id",
        "with_check": null
      },
      {
        "name": "Authenticated users can insert bookmarks",
        "cmd": "insert",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": null,
        "with_check": "auth.uid()=user_id"
      },
      {
        "name": "Users can view own bookmarks",
        "cmd": "select",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "auth.uid()=user_id",
        "with_check": null
      }
    ],
    "public.comments": [
      {
        "name": "Users can delete own comments",
        "cmd": "delete",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "auth.uid()=user_id",
        "with_check": null
      },
      {
        "name": "Users can comment on visible posts",
        "cmd": "insert",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": null,
        "with_check": "(auth.uid()=user_id)and can_view_post(post_id)"
      },
      {
        "name": "Users can view comments on visible posts",
        "cmd": "select",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "can_view_post(post_id)",
        "with_check": null
      }
    ],
    "public.conversation_participants": [
      {
        "name": "Users can leave conversations",
        "cmd": "delete",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "auth.uid()=user_id",
        "with_check": null
      },
      {
        "name": "Users can add conversation participants",
        "cmd": "insert",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": null,
        "with_check": "(auth.uid()is not null)and((user_id=auth.uid())or is_conversation_participant(conversation_id))"
      },
      {
        "name": "Participants can view conversation members",
        "cmd": "select",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "is_conversation_participant(conversation_id)",
        "with_check": null
      }
    ],
    "public.conversations": [
      {
        "name": "Authenticated users can create conversations",
        "cmd": "insert",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": null,
        "with_check": "auth.uid()is not null"
      },
      {
        "name": "Participants can view conversations",
        "cmd": "select",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "is_conversation_participant(id)",
        "with_check": null
      }
    ],
    "public.follows": [
      {
        "name": "Users can delete own follows",
        "cmd": "delete",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "auth.uid()=follower_id",
        "with_check": null
      },
      {
        "name": "Authenticated users can insert follows",
        "cmd": "insert",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": null,
        "with_check": "auth.uid()=follower_id"
      },
      {
        "name": "Anyone can view follows",
        "cmd": "select",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "true",
        "with_check": null
      }
    ],
    "public.likes": [
      {
        "name": "Users can delete own likes",
        "cmd": "delete",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "auth.uid()=user_id",
        "with_check": null
      },
      {
        "name": "Users can like visible posts",
        "cmd": "insert",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": null,
        "with_check": "(auth.uid()=user_id)and can_view_post(post_id)"
      },
      {
        "name": "Users can view likes on visible posts",
        "cmd": "select",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "can_view_post(post_id)",
        "with_check": null
      }
    ],
    "public.messages": [
      {
        "name": "Participants can send messages",
        "cmd": "insert",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": null,
        "with_check": "(auth.uid()=sender_id)and is_conversation_participant(conversation_id)"
      },
      {
        "name": "Participants can view messages",
        "cmd": "select",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "is_conversation_participant(conversation_id)",
        "with_check": null
      },
      {
        "name": "Participants can update messages",
        "cmd": "update",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "is_conversation_participant(conversation_id)",
        "with_check": "is_conversation_participant(conversation_id)"
      }
    ],
    "public.music_tracks": [
      {
        "name": "Service role can write music tracks",
        "cmd": "all",
        "roles": [
          "service_role"
        ],
        "permissive": "permissive",
        "using": "true",
        "with_check": "true"
      },
      {
        "name": "Anyone can read music tracks",
        "cmd": "select",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "true",
        "with_check": null
      },
      {
        "name": "Authenticated users can read music tracks",
        "cmd": "select",
        "roles": [
          "authenticated"
        ],
        "permissive": "permissive",
        "using": "true",
        "with_check": null
      }
    ],
    "public.notifications": [
      {
        "name": "Users can delete own notifications",
        "cmd": "delete",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "auth.uid()=user_id",
        "with_check": null
      },
      {
        "name": "Authenticated users can insert notifications",
        "cmd": "insert",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": null,
        "with_check": "auth.uid()=from_user_id"
      },
      {
        "name": "Users can view own notifications",
        "cmd": "select",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "auth.uid()=user_id",
        "with_check": null
      },
      {
        "name": "Users can update own notifications",
        "cmd": "update",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "auth.uid()=user_id",
        "with_check": null
      }
    ],
    "public.posts": [
      {
        "name": "Users can delete own posts",
        "cmd": "delete",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "auth.uid()=user_id",
        "with_check": null
      },
      {
        "name": "Authenticated users can insert their own posts",
        "cmd": "insert",
        "roles": [
          "authenticated"
        ],
        "permissive": "permissive",
        "using": null,
        "with_check": "auth.uid()=user_id"
      },
      {
        "name": "Users can view visible posts",
        "cmd": "select",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "(auth.uid()=user_id)or can_view_post(id)",
        "with_check": null
      },
      {
        "name": "Users can update own posts",
        "cmd": "update",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "auth.uid()=user_id",
        "with_check": null
      }
    ],
    "public.profiles": [
      {
        "name": "Authenticated users can insert their own profiles",
        "cmd": "insert",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": null,
        "with_check": "auth.uid()=id"
      },
      {
        "name": "Public profile shells are readable",
        "cmd": "select",
        "roles": [
          "anon",
          "authenticated"
        ],
        "permissive": "permissive",
        "using": "true",
        "with_check": null
      },
      {
        "name": "Users can update own profile",
        "cmd": "update",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "auth.uid()=id",
        "with_check": null
      }
    ],
    "public.reposts": [
      {
        "name": "Users can delete own reposts",
        "cmd": "delete",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "auth.uid()=user_id",
        "with_check": null
      },
      {
        "name": "Users can repost visible posts",
        "cmd": "insert",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": null,
        "with_check": "(auth.uid()=user_id)and can_view_post(post_id)"
      },
      {
        "name": "Users can view reposts on visible posts",
        "cmd": "select",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "can_view_post(post_id)",
        "with_check": null
      }
    ],
    "public.stories": [
      {
        "name": "Users can delete own stories",
        "cmd": "delete",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "auth.uid()=user_id",
        "with_check": null
      },
      {
        "name": "Users can insert own stories",
        "cmd": "insert",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": null,
        "with_check": "auth.uid()=user_id"
      },
      {
        "name": "Stories are visible to followers and public users",
        "cmd": "select",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "(expires_at>now())and((auth.uid()=user_id)or(exists(select 1 from profiles p where((p.id=stories.user_id)and(p.is_private=false))))or(exists(select 1 from follows f where((f.following_id=stories.user_id)and(f.follower_id=auth.uid())))))",
        "with_check": null
      },
      {
        "name": "Users can update own stories",
        "cmd": "update",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "auth.uid()=user_id",
        "with_check": null
      }
    ],
    "public.story_views": [
      {
        "name": "Authenticated users can insert story views",
        "cmd": "insert",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": null,
        "with_check": "auth.uid()=viewer_id"
      },
      {
        "name": "Story views are visible to story owner and viewer",
        "cmd": "select",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "(viewer_id=auth.uid())or(exists(select 1 from stories s where((s.id=story_views.story_id)and(s.user_id=auth.uid()))))",
        "with_check": null
      }
    ],
    "storage.objects": [
      {
        "name": "Only the service role can delete sounds",
        "cmd": "delete",
        "roles": [
          "service_role"
        ],
        "permissive": "permissive",
        "using": "bucket_id='sounds'::text",
        "with_check": null
      },
      {
        "name": "Users can delete their own avatar",
        "cmd": "delete",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "(bucket_id='avatars'::text)and((storage.foldername(name))[1]=(auth.uid())::text)",
        "with_check": null
      },
      {
        "name": "Users can delete their own chat media",
        "cmd": "delete",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "(bucket_id='chat'::text)and((storage.foldername(name))[1]=(auth.uid())::text)",
        "with_check": null
      },
      {
        "name": "Users can delete their own posts",
        "cmd": "delete",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "(bucket_id='posts'::text)and((storage.foldername(name))[1]=(auth.uid())::text)",
        "with_check": null
      },
      {
        "name": "Users can delete their own story media",
        "cmd": "delete",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "(bucket_id='stories'::text)and((storage.foldername(name))[1]=(auth.uid())::text)",
        "with_check": null
      },
      {
        "name": "Only the service role can upload sounds",
        "cmd": "insert",
        "roles": [
          "service_role"
        ],
        "permissive": "permissive",
        "using": null,
        "with_check": "bucket_id='sounds'::text"
      },
      {
        "name": "Users can upload their own avatar",
        "cmd": "insert",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": null,
        "with_check": "(bucket_id='avatars'::text)and((storage.foldername(name))[1]=(auth.uid())::text)"
      },
      {
        "name": "Users can upload their own chat media",
        "cmd": "insert",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": null,
        "with_check": "(bucket_id='chat'::text)and(auth.uid()is not null)and((storage.foldername(name))[1]=(auth.uid())::text)"
      },
      {
        "name": "Users can upload their own posts",
        "cmd": "insert",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": null,
        "with_check": "(bucket_id='posts'::text)and((storage.foldername(name))[1]=(auth.uid())::text)"
      },
      {
        "name": "Users can upload their own story media",
        "cmd": "insert",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": null,
        "with_check": "(bucket_id='stories'::text)and((storage.foldername(name))[1]=(auth.uid())::text)"
      },
      {
        "name": "Avatar images are publicly accessible",
        "cmd": "select",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "bucket_id='avatars'::text",
        "with_check": null
      },
      {
        "name": "Chat media is readable by participants",
        "cmd": "select",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "(bucket_id='chat'::text)and(auth.uid()is not null)and(((storage.foldername(name))[1]=(auth.uid())::text)or(exists(select 1 from(messages m join conversation_participants cp on((cp.conversation_id=m.conversation_id)))where((cp.user_id=auth.uid())and(m.media_url=objects.name)))))",
        "with_check": null
      },
      {
        "name": "Post images are publicly accessible",
        "cmd": "select",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "bucket_id='posts'::text",
        "with_check": null
      },
      {
        "name": "Sound files are publicly readable",
        "cmd": "select",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "bucket_id='sounds'::text",
        "with_check": null
      },
      {
        "name": "Story media is publicly accessible",
        "cmd": "select",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "bucket_id='stories'::text",
        "with_check": null
      },
      {
        "name": "Only the service role can replace sounds",
        "cmd": "update",
        "roles": [
          "service_role"
        ],
        "permissive": "permissive",
        "using": "bucket_id='sounds'::text",
        "with_check": "bucket_id='sounds'::text"
      },
      {
        "name": "Users can update their own avatar",
        "cmd": "update",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "(bucket_id='avatars'::text)and((storage.foldername(name))[1]=(auth.uid())::text)",
        "with_check": "(bucket_id='avatars'::text)and((storage.foldername(name))[1]=(auth.uid())::text)"
      },
      {
        "name": "Users can update their own chat media",
        "cmd": "update",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "(bucket_id='chat'::text)and((storage.foldername(name))[1]=(auth.uid())::text)",
        "with_check": "(bucket_id='chat'::text)and((storage.foldername(name))[1]=(auth.uid())::text)"
      },
      {
        "name": "Users can update their own posts",
        "cmd": "update",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "(bucket_id='posts'::text)and((storage.foldername(name))[1]=(auth.uid())::text)",
        "with_check": "(bucket_id='posts'::text)and((storage.foldername(name))[1]=(auth.uid())::text)"
      },
      {
        "name": "Users can update their own story media",
        "cmd": "update",
        "roles": [
          "public"
        ],
        "permissive": "permissive",
        "using": "(bucket_id='stories'::text)and((storage.foldername(name))[1]=(auth.uid())::text)",
        "with_check": "(bucket_id='stories'::text)and((storage.foldername(name))[1]=(auth.uid())::text)"
      }
    ]
  },
  "buckets": {
    "avatars": true,
    "chat": false,
    "posts": true,
    "sounds": true,
    "stories": true
  },
  "triggers": {
    "protect_message_updates": "messages"
  }
}
