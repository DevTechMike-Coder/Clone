EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-key
# "Web application" OAuth client ID from Google Cloud Console (see GOOGLE_SIGNIN_SETUP.md)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Seed-only, server side. Used by `npm run seed:music` to upload to the `sounds`
# bucket and upsert public.music_tracks (which is not writable by `authenticated`
# on purpose). NEVER prefix this with EXPO_PUBLIC_: anything exposed to the
# client can be lifted out of the bundle. Keep it in .env.local (gitignored).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
